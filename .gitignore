# Dependencies
backend/vendor/
frontend/node_modules/

# Environment (single file at project root)
.env
backend/.env
frontend/.env

# Laravel cache & logs
backend/storage/logs/*.log
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/bootstrap/cache/*.php
*.log
*-server.log
*-server.err.log
mysql-start.log
mysql-start.err.log

# Build output
frontend/dist/
frontend/dist-check-*/
.vite-cache/

# Hostinger deploy output (may contain secrets)
deploy/*.zip
deploy/.env.hostinger
deploy/_v/deploy/.env.hostinger
deploy/_v/backend/.tmp-appdata/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.suo
*.user

# Claude Code memory
.claude/

# Composer binary (already tracked, skip re-adding)
composer.exe
