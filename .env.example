# Copy: copy .env.example .env

APP_NAME="Shadow Attendance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Phnom_Penh

SUPER_ADMIN_EMAIL=superadmin@shadow.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMPLOYEE_CODE=SUPER-0001
ADMIN_EMAIL=admin@shadow.com
ADMIN_PASSWORD=change-me
ADMIN_NAME="Admin User"
ADMIN_EMPLOYEE_CODE=ADMIN-0001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_sales_app
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5174,127.0.0.1,127.0.0.1:5174,127.0.0.1:8000

# public = local disk | r2 = Cloudflare R2
ATTENDANCE_IMAGE_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=attendance-shadow
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=
VITE_GOOGLE_MAPS_API_KEY=

DEV_LAN_IP=
DEV_HTTPS=true
